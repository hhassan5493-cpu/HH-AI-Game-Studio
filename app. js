
const $ = id => document.getElementById(id);

let currentTool = "game";
let lastResult = null;

const tools = {
  game: ["01", "AI Game Creator", "Create a game plan."],
  world: ["02", "AI World Generator", "Design game worlds."],
  character: ["03", "AI Character Designer", "Design characters."],
  mission: ["04", "AI Mission Creator", "Create missions."],
  mechanics: ["05", "AI Mechanics Designer", "Design game systems."],
  code: ["06", "AI Prototype Code", "Generate starter code."]
};

function setTool(name) {
  currentTool = name;
  document.querySelectorAll(".nav").forEach(b =>
    b.classList.toggle("active", b.dataset.tool === name)
  );
  const t = tools[name];
  $("toolNumber").textContent = t[0];
  $("toolTitle").textContent = t[1];
  $("toolDesc").textContent = t[2];
}

document.querySelectorAll(".nav").forEach(b =>
  b.addEventListener("click", () => setTool(b.dataset.tool))
);

async function status() {
  try {
    const r = await fetch("/api/status");
    const d = await r.json();
    $("apiStatus").textContent =
      d.aiConnected ? "AI API connected" : "AI API key required";
  } catch {
    $("apiStatus").textContent = "Server not connected";
  }
}

status();

$("runAI").addEventListener("click", runAI);

async function runAI() {
  const prompt = $("prompt").value.trim();

  if (prompt.length < 5) {
    $("output").textContent = "Please describe your game first.";
    return;
  }

  $("runAI").disabled = true;
  $("runAI").textContent = "AI is working...";

  try {
    const r = await fetch("/api/ai", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({
        tool: currentTool,
        prompt: prompt,
        genre: $("genre").value,
        platform: $("platform").value
      })
    });

    const data = await r.json();

    if (!r.ok) throw new Error(data.error);

    lastResult = data.data;
    $("output").textContent =
      JSON.stringify(lastResult, null, 2);

  } catch (error) {
    $("output").textContent = error.message;
  }

  $("runAI").disabled = false;
  $("runAI").textContent = "Generate with AI";
  status();
}

$("saveProject").addEventListener("click", () => {
  const project = {
    prompt: $("prompt").value,
    result: lastResult
  };

  localStorage.setItem(
    "hhStudioProject",
    JSON.stringify(project)
  );

  $("saveProject").textContent = "Saved!";
});
